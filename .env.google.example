# Google OAuth2 / OIDC para Kong
# https://developer.conghq.com/plugins/openid-connect/examples/google/
GOOGLE_CLIENT_ID=[your-client-id].apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=[your-client-secret]
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_REDIRECT_URI=http://localhost/auth/callback

# JWT da aplicacao (emitido pelo auth-api e validado pelo Kong JWT plugin)
APP_JWT_SECRET=change-me-in-production
KONG_JWT_ISSUER=fusca-app
APP_JWT_AUDIENCE=fusca-api
APP_JWT_EXPIRES_IN=1h